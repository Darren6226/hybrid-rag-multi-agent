# ============================================================
# 混合 RAG 多代理系统 — 环境变量配置
# ============================================================
# 复制此文件为 .env 并填入真实值：
#   cp .env.example .env
# 注意：.env 已被 .gitignore 排除，不会被提交到版本控制。

# ============================================================
# DashScope（阿里云通义千问）— 主要 LLM 提供商
# ============================================================
# 必填：DashScope API Key
# 获取：https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# 可选：DashScope API 基础 URL
# 使用阿里云原生 API 时留空即可
# 使用 ModelScope 兼容端点时填写：
# DASHSCOPE_API_BASE=https://api-inference.modelscope.cn/v1

# ============================================================
# SenseNova（商汤）— DeepSeek 模型的备选提供商
# ============================================================
# 可选：配置后系统可使用 DeepSeek-v4-flash 模型
# 获取：https://sensenova.sensetime.com/
# SENSENOVA_API_KEY=your-sensenova-api-key-here

# ============================================================
# ModelScope — DashScope 免费额度用完时的 fallback
# ============================================================
# modelscope_base_url=https://api-inference.modelscope.cn/v1
# modelscope_api_key=your-modelscope-api-key-here
